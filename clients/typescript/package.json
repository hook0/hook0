{
  "name": "hook0-client",
  "version": "1.1.0",
  "main": "dist/index.js",
  "module": "esm/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.mts",
        "default": "./esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "/dist",
    "/esm",
    "/assets"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "api-surface:update": "ts-node tests/apiSurface.update.ts",
    "lint": "eslint .",
    "format": "prettier --write ./{src,tests}/{*,**/*}.ts ./esm/*.{mjs,mts}",
    "check": "prettier --check ./{src,tests}/{*,**/*}.ts ./esm/*.{mjs,mts}",
    "check-full": "npm run --silent check && npm run --silent lint && npm run --silent build && npm run --silent test",
    "release-major": "npm run --silent check-full && npm-release major",
    "release-minor": "npm run --silent check-full && npm-release minor",
    "release-patch": "npm run --silent check-full && npm-release patch"
  },
  "keywords": [],
  "authors": [
    "David Sferruzza <david@hook0.com>",
    "François-Guillaume Ribreau <fg@hook0.com>"
  ],
  "license": "MIT",
  "description": "TypeScript SDK for Hook0 Open-Source Webhooks as a service for SaaS",
  "homepage": "https://hook0.com/",
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@jest/globals": "^30.1.2",
    "@types/crypto-js": "^4.2.2",
    "eslint": "^9.19.0",
    "fast-check": "^4.9.0",
    "jest": "^30.1.3",
    "npm-release": "^1.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
