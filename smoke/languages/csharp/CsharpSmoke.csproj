<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Holds the C# client against a Hook0 that is really running. The reference is to the client's own
    project rather than to a package, so what is exercised is the source in this repository.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Hook0.Smoke</RootNamespace>
    <AssemblyName>Hook0.Smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../clients/csharp/src/Hook0.Client.csproj" />
  </ItemGroup>

</Project>
