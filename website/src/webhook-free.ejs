<%
// Data-driven page: see scripts/build-i18n + locales/index.js for the engine.
// Object.assign at the very top resets every page-meta key from locale strings,
// killing the shared-locals bleed, and binds `t` to this page's strings.
// Runs BEFORE any output so <html lang> sees pageLang.
if (locals.i18nHelpers) { Object.assign(locals, locals.i18nHelpers.getPageLocals('webhook-free', locals.lang || 'en')); }
var t = locals.t;
%><!DOCTYPE html>
<html lang="<%= locals.pageLang %>">
<head>
    <title><%= locals.pageTitle %></title>
    <%- include('./includes/_head.ejs') %>
</head>
<body>
<%- include('./includes/_header.ejs') %>

<!-- Hero Section -->
<section class="relative gradient-hero overflow-hidden py-20 sm:py-28">
    <div class="absolute inset-0 grid-pattern opacity-50"></div>
    <div class="blur-circle blur-circle--indigo w-96 h-96 -top-48 -left-48"></div>
    <div class="blur-circle blur-circle--green w-80 h-80 top-1/2 -right-40"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="section__eyebrow"><%= t.hero.eyebrow %></span>
        <h1 class="mt-4 text-display-xl text-white">
            <%= t.hero.titleLine1 %>
            <span class="block text-gradient-green"><%= t.hero.titleLine2 %></span>
        </h1>
        <p class="mt-6 text-body-lg text-gray-400 max-w-2xl mx-auto">
            <%- t.hero.subtitleHtml %>
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://play.hook0.com" target="_blank" rel="noopener" class="btn btn--primary btn--lg group" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-hero-play')">
                <%= t.hero.ctaPlay %>
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
            </a>
            <a href="<%= t.selfHostHref %>" class="btn btn--secondary btn--lg" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-hero-selfhost')">
                <%= t.hero.ctaSelfHost %>
            </a>
        </div>
        <p class="mt-4 text-sm text-gray-500"><%= t.hero.microcopy %></p>

        <figure class="mt-14 max-w-3xl mx-auto animate-on-scroll">
          <svg viewBox="0 0 720 110" role="img" aria-labelledby="flow-title flow-desc" class="w-full h-auto" style="max-width:720px;">
            <title id="flow-title"><%= t.flow.title %></title>
            <desc id="flow-desc"><%= t.flow.desc %></desc>
            <defs>
              <style>
                .h0n{fill:#14141a;}
                .h0lbl{font-family:ui-monospace,'SFMono-Regular',Menlo,monospace;font-size:13px;fill:#e5e7eb;}
                .h0sub{font-family:ui-monospace,'SFMono-Regular',Menlo,monospace;font-size:10px;fill:#9ca3af;}
                .h0dash{stroke:#818cf8;stroke-width:2.5;stroke-dasharray:5 9;animation:h0flow 1.1s linear infinite;}
                @keyframes h0flow{to{stroke-dashoffset:-14;}}
              </style>
            </defs>
            <!-- baseline + animated event flow (visible in the gaps between stages) -->
            <line x1="104" y1="66" x2="704" y2="66" stroke="rgba(255,255,255,.14)" stroke-width="2.5"/>
            <line x1="104" y1="66" x2="704" y2="66" class="h0dash"/>
            <!-- stages -->
            <g>
              <rect class="h0n" x="8" y="44" width="96" height="44" rx="8" stroke="rgba(255,255,255,.22)"/>
              <text class="h0lbl" x="56" y="71" text-anchor="middle"><%= t.flow.event %></text>
            </g>
            <g>
              <rect class="h0n" x="128" y="44" width="96" height="44" rx="8" stroke="rgba(255,255,255,.22)"/>
              <text class="h0lbl" x="176" y="64" text-anchor="middle"><%= t.flow.sign %></text>
              <text class="h0sub" x="176" y="79" text-anchor="middle">HMAC</text>
            </g>
            <g>
              <rect class="h0n" x="248" y="44" width="96" height="44" rx="8" stroke="rgba(255,255,255,.22)"/>
              <text class="h0lbl" x="296" y="71" text-anchor="middle"><%= t.flow.deliver %></text>
            </g>
            <g>
              <rect class="h0n" x="368" y="44" width="96" height="44" rx="8" stroke="#fe884e"/>
              <text class="h0lbl" x="416" y="71" text-anchor="middle" fill="#fdba74">503</text>
            </g>
            <g>
              <rect class="h0n" x="488" y="44" width="96" height="44" rx="8" stroke="#fe884e"/>
              <text class="h0lbl" x="536" y="71" text-anchor="middle" fill="#fdba74"><%= t.flow.retry %></text>
            </g>
            <g>
              <rect class="h0n" x="608" y="44" width="96" height="44" rx="8" stroke="#818cf8"/>
              <text class="h0lbl" x="656" y="71" text-anchor="middle" fill="#c7d2fe">200 ✓</text>
            </g>
          </svg>
          <figcaption class="mt-4 text-center text-sm text-gray-500"><%= t.flow.caption %></figcaption>
        </figure>
    </div>
</section>

<%- include('./includes/_social-proof-bar.ejs') %>

<!-- Pick your path: receive (Play) vs send (Cloud / self-host) -->
<section class="section relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 animate-on-scroll">
            <span class="section__eyebrow"><%= t.router.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.router.h2 %></h2>
            <p class="mt-4 text-body text-gray-400 max-w-2xl mx-auto"><%= t.router.subtitle %></p>
        </div>
        <% var d = t.router.diagram; %>
        <figure class="animate-on-scroll max-w-4xl mx-auto mb-12">
          <svg viewBox="0 0 900 250" role="img" aria-labelledby="roles-title roles-desc" class="w-full h-auto">
            <title id="roles-title"><%= d.title %></title>
            <desc id="roles-desc"><%= d.desc %></desc>
            <defs>
              <style>
                .r0n{fill:#14141a;}
                .r0lbl{font-family:ui-monospace,'SFMono-Regular',Menlo,monospace;font-size:13px;fill:#e5e7eb;}
                .r0sub{font-family:ui-monospace,'SFMono-Regular',Menlo,monospace;font-size:10px;fill:#9ca3af;}
                .r0eye{font-family:Inter,system-ui,sans-serif;font-size:12px;font-weight:700;letter-spacing:.09em;fill:#818cf8;}
                .r0arrow{stroke:#818cf8;stroke-width:1.6;fill:none;}
              </style>
              <marker id="r0ah" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M0,1 L6,4 L0,7" fill="none" stroke="#818cf8" stroke-width="1.5"/></marker>
            </defs>

            <line x1="450" y1="20" x2="450" y2="230" stroke="rgba(255,255,255,.12)" stroke-width="1.5" stroke-dasharray="3 5"/>

            <!-- LEFT: receive & debug -->
            <text class="r0eye" x="24" y="40"><%= d.receiveEyebrow %></text>
            <text class="r0sub" x="24" y="58"><%= d.receiveSub %></text>
            <g>
              <rect class="r0n" x="24" y="110" width="132" height="54" rx="8" stroke="rgba(255,255,255,.22)"/>
              <text class="r0lbl" x="90" y="140" text-anchor="middle"><%= d.service %></text>
              <text class="r0sub" x="90" y="156" text-anchor="middle"><%= d.serviceSub %></text>
            </g>
            <line x1="156" y1="137" x2="246" y2="137" class="r0arrow" marker-end="url(#r0ah)"/>
            <text class="r0sub" x="201" y="128" text-anchor="middle">POST</text>
            <g>
              <rect class="r0n" x="250" y="110" width="160" height="54" rx="8" stroke="#818cf8"/>
              <text class="r0lbl" x="330" y="135" text-anchor="middle" fill="#c7d2fe">Hook0 Play</text>
              <text class="r0sub" x="330" y="153" text-anchor="middle"><%= d.playSub %></text>
            </g>

            <!-- RIGHT: send signed -->
            <text class="r0eye" x="486" y="40"><%= d.sendEyebrow %></text>
            <text class="r0sub" x="486" y="58"><%= d.sendSub %></text>
            <g>
              <rect class="r0n" x="486" y="110" width="120" height="54" rx="8" stroke="#818cf8"/>
              <text class="r0lbl" x="546" y="135" text-anchor="middle" fill="#c7d2fe">Hook0</text>
              <text class="r0sub" x="546" y="153" text-anchor="middle"><%= d.hook0Sub %></text>
            </g>
            <line x1="606" y1="137" x2="772" y2="84" class="r0arrow" marker-end="url(#r0ah)"/>
            <line x1="606" y1="137" x2="772" y2="137" class="r0arrow" marker-end="url(#r0ah)"/>
            <line x1="606" y1="137" x2="772" y2="190" class="r0arrow" marker-end="url(#r0ah)"/>
            <text class="r0sub" x="690" y="96" text-anchor="middle" fill="#a5b4fc"><%= d.signed %></text>
            <text class="r0sub" x="690" y="214" text-anchor="middle" fill="#fdba74"><%= d.autoRetry %></text>
            <g>
              <rect class="r0n" x="772" y="66" width="108" height="36" rx="6" stroke="rgba(255,255,255,.22)"/>
              <text class="r0lbl" x="826" y="89" text-anchor="middle"><%= d.yourUser %></text>
            </g>
            <g>
              <rect class="r0n" x="772" y="119" width="108" height="36" rx="6" stroke="rgba(255,255,255,.22)"/>
              <text class="r0lbl" x="826" y="142" text-anchor="middle"><%= d.yourUser %></text>
            </g>
            <g>
              <rect class="r0n" x="772" y="172" width="108" height="36" rx="6" stroke="rgba(255,255,255,.22)"/>
              <text class="r0lbl" x="826" y="195" text-anchor="middle"><%= d.yourUser %></text>
            </g>
          </svg>
          <figcaption class="mt-4 text-center text-sm text-gray-500"><%- t.router.captionHtml %></figcaption>
        </figure>

        <div class="grid md:grid-cols-2 gap-8 stagger-children">
            <div class="animate-on-scroll card card--glow p-8 flex flex-col">
                <h3 class="text-xl font-bold text-white mb-3"><%= t.router.test.title %></h3>
                <p class="text-gray-400 flex-1"><%= t.router.test.body %></p>
                <a href="https://play.hook0.com" target="_blank" rel="noopener" class="btn btn--primary mt-6 self-start" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-router-play')"><%= t.router.test.cta %></a>
                <p class="mt-3 text-sm text-gray-500"><%= t.router.test.note %></p>
            </div>
            <div class="animate-on-scroll card card--glow p-8 flex flex-col">
                <h3 class="text-xl font-bold text-white mb-3"><%= t.router.infra.title %></h3>
                <p class="text-gray-400 flex-1"><%= t.router.infra.body %></p>
                <div class="flex flex-wrap gap-3 mt-6">
                    <a href="<%= t.selfHostHref %>" class="btn btn--secondary self-start" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-router-selfhost')"><%= t.router.infra.ctaSelfHost %></a>
                    <a href="https://app.hook0.com/register" class="btn btn--secondary self-start" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-router-cloud')"><%= t.router.infra.ctaCloud %></a>
                </div>
                <p class="mt-3 text-sm text-gray-500"><%= t.router.infra.note %></p>
            </div>
        </div>
    </div>
</section>

<!-- The three free ways -->
<section class="section relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="blur-circle blur-circle--green w-64 h-64 top-1/4 right-0 opacity-10"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 animate-on-scroll">
            <span class="section__eyebrow"><%= t.ways.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.ways.h2 %></h2>
            <p class="mt-4 text-body text-gray-400 max-w-2xl mx-auto"><%= t.ways.subtitle %></p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 stagger-children">
            <% t.ways.cards.forEach(function (c) { %>
            <div class="animate-on-scroll card card--glow p-8 flex flex-col">
                <h3 class="text-xl font-bold text-white mb-2"><%= c.title %></h3>
                <p class="text-sm text-green-400 font-semibold mb-3"><%= c.badge %></p>
                <p class="text-gray-400 flex-1"><%= c.body %></p>
                <p class="mt-4 text-sm text-gray-500"><%= c.bestFor %></p>
                <a href="<%= c.href %>"<% if (c.external) { %> target="_blank" rel="noopener"<% } %> class="text-indigo-400 hover:text-indigo-300 underline mt-3" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-card-<%= c.id %>')"><%= c.cta %></a>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Free offers compared across webhook tools -->
<section class="section relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 animate-on-scroll">
            <span class="section__eyebrow"><%= t.compare.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.compare.h2 %></h2>
            <p class="mt-4 text-body text-gray-400 max-w-2xl mx-auto"><%= t.compare.subtitle %></p>
        </div>

        <div class="animate-on-scroll overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-white/10">
                        <th class="py-4 px-6 text-sm font-semibold text-gray-400 uppercase tracking-wider"><%= t.compare.headers.criteria %></th>
                        <th class="py-4 px-6 text-sm font-semibold text-green-400 uppercase tracking-wider"><%= t.compare.headers.hook0 %></th>
                        <th class="py-4 px-6 text-sm font-semibold text-gray-400 uppercase tracking-wider"><%= t.compare.headers.svix %></th>
                        <th class="py-4 px-6 text-sm font-semibold text-gray-400 uppercase tracking-wider"><%= t.compare.headers.hookdeck %></th>
                        <th class="py-4 px-6 text-sm font-semibold text-gray-400 uppercase tracking-wider"><%= t.compare.headers.webhooksite %></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5 stagger-children--tight">
                    <% t.compare.rows.forEach(function (r) { %>
                    <tr class="hover:bg-white/5 transition-colors animate-on-scroll"><td class="py-4 px-6 text-gray-300"><%= r.criteria %></td><td class="py-4 px-6 text-green-400 font-medium"><%= r.hook0 %></td><td class="py-4 px-6 text-gray-400"><%= r.svix %></td><td class="py-4 px-6 text-gray-400"><%= r.hookdeck %></td><td class="py-4 px-6 text-gray-400"><%= r.webhooksite %></td></tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <p class="mt-4 text-xs text-gray-500 text-center"><%= t.compare.footnote %></p>
    </div>
</section>

<!-- Where free ends -->
<section class="section relative overflow-hidden">
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 animate-on-scroll">
            <span class="section__eyebrow"><%= t.limits.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.limits.h2 %></h2>
        </div>
        <div class="animate-on-scroll card card--glow p-8">
            <p class="text-gray-400"><%= t.limits.intro %></p>
            <ul class="mt-4 space-y-3 text-gray-400 list-disc list-inside stagger-children--tight">
                <% t.limits.itemsHtml.forEach(function (li) { %>
                <li class="animate-on-scroll"><%- li %></li>
                <% }); %>
            </ul>
            <div class="mt-6">
                <a href="<%= t.limits.ctaHref %>" class="text-indigo-400 hover:text-indigo-300 underline" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-pricing')"><%= t.limits.cta %></a>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section. The same faq.items array feeds the FAQPage JSON-LD
     (locales/index.js faqToSchema), so visible answers and schema never drift. -->
<section class="section relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 animate-on-scroll">
            <span class="section__eyebrow"><%= t.faq.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.faq.h2 %></h2>
        </div>

        <div class="space-y-6 stagger-children--tight">
            <% t.faq.items.forEach(function (f) { %>
            <div class="animate-on-scroll card card--glow p-6">
                <h3 class="text-lg font-semibold text-white mb-2"><%= f.q %></h3>
                <p class="text-gray-400"><%= f.a %></p>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Related Pages -->
<section class="py-12 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-lg font-semibold text-gray-400 mb-6 text-center"><%= t.related.h2 %></h2>
        <div class="flex flex-wrap justify-center gap-4 text-sm">
            <% t.related.links.forEach(function (l) { %>
            <a href="<%= l.href %>"<% if (l.external) { %> target="_blank" rel="noopener"<% } %> class="text-indigo-400 hover:text-indigo-300 underline"><%= l.label %></a>
            <% }); %>
        </div>
    </div>
</section>

<!-- CTA Section -->
<%- include('./includes/_cta-inline.ejs') %>

<%- include('./includes/_footer.ejs') %>

</body>
</html>
