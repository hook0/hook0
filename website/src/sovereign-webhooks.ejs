<%
// Data-driven page: see scripts/build-i18n + locales/index.js for the engine.
// Object.assign at the very top resets every page-meta key from locale strings,
// killing the shared-locals bleed, and binds `t` to this page's strings.
// Runs BEFORE any output so <html lang> sees pageLang.
if (locals.i18nHelpers) { Object.assign(locals, locals.i18nHelpers.getPageLocals('sovereign-webhooks', locals.lang || 'en')); }
var t = locals.t;
// Locale-aware internal links: resolve enSlug -> localized path, falling back
// to the EN path when a related page is not translated for this locale.
var getPath = (locals.i18nHelpers && locals.i18nHelpers.getPath) ? locals.i18nHelpers.getPath : function (s) { return './' + s; };
%><!DOCTYPE html>
<html lang="<%= locals.pageLang %>">
<head>
    <title><%= locals.pageTitle %></title>
    <%- include('./includes/_head.ejs') %>
</head>
<body>
<%- include('./includes/_header.ejs') %>

<!-- Hero Section -->
<section class="relative gradient-hero overflow-hidden py-20 sm:py-28">
    <div class="absolute inset-0 grid-pattern opacity-50"></div>
    <div class="blur-circle blur-circle--indigo w-96 h-96 -top-48 -left-48"></div>
    <div class="blur-circle blur-circle--green w-80 h-80 top-1/2 -right-40"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="section__eyebrow"><%= t.hero.eyebrow %></span>
        <h1 class="mt-4 text-display-xl text-white">
            <%= t.hero.titleLine1 %>
            <span class="block text-gradient-green"><%= t.hero.titleLine2 %></span>
        </h1>
        <p class="mt-6 text-body-lg text-gray-400 max-w-2xl mx-auto">
            <%= t.hero.subtitle %>
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://app.hook0.com/register" class="btn btn--primary btn--lg group" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-hero-register')">
                <%= t.hero.ctaPrimary %>
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
            </a>
            <a href="<%= t.hero.ctaSecondaryHref %>" class="btn btn--secondary btn--lg" onclick="trackEvent('CTA', 'Click', '<%= t.track %>-hero-eu')">
                <%= t.hero.ctaSecondary %>
            </a>
        </div>
        <p class="mt-4 text-sm text-gray-500"><%= t.hero.microcopy %></p>
    </div>
</section>

<% if (t.socialProof) { %>
<%- include('./includes/_social-proof-bar.ejs') %>
<% } %>

<!-- Direct-answer summary (AEO): a self-contained lead answer that featured
     snippets and AI Overviews can lift verbatim. States the sovereignty angle
     ("who can be legally compelled" rather than "where the server sits") up
     front, grounded entirely in Hook0's verifiable, already-published facts. -->
<% if (t.tldr) { %>
<section class="section relative overflow-hidden">
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="card card--glow p-8 animate-on-scroll">
            <h2 class="text-xl font-bold text-white mb-3"><%= t.tldr.h2 %></h2>
            <p class="text-body-lg text-gray-300"><%= t.tldr.body %></p>
        </div>
    </div>
</section>
<% } %>

<!-- The three dimensions of sovereignty (teaching section: public framework
     knowledge, no Hook0 claim). Frames why "localise != sovereign". -->
<section class="section relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="blur-circle blur-circle--green w-64 h-64 top-1/4 right-0 opacity-10"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 animate-on-scroll">
            <span class="section__eyebrow"><%= t.dimensions.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.dimensions.h2 %></h2>
            <p class="mt-4 text-body text-gray-400 max-w-2xl mx-auto"><%= t.dimensions.intro %></p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 stagger-children">
            <% t.dimensions.cards.forEach(function (c) { %>
            <div class="animate-on-scroll card card--glow p-6">
                <h3 class="text-lg font-bold text-white mb-3"><%= c.title %></h3>
                <p class="text-gray-400"><%- c.bodyHtml %></p>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- The real question: who can be legally compelled. CLOUD Act framed as public
     legal fact + a vendor checklist (generic, no competitor named), then Hook0's
     facts, then a legally-reviewed bounded statement (legalHtml). That statement
     is /legal-validated verbatim copy: it ties the CLOUD Act analysis to the
     publishing entity and the data it controls only, names Cloudflare (US) as
     staying in scope, and carries the "no absolute guarantee" caveat. Rendered
     verbatim (never rephrased) so the reviewed legal wording stays intact. -->
<section class="section relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 animate-on-scroll">
            <span class="section__eyebrow"><%= t.compulsion.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.compulsion.h2 %></h2>
            <p class="mt-4 text-body text-gray-400 max-w-2xl mx-auto"><%= t.compulsion.intro %></p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 stagger-children items-start">
            <div class="animate-on-scroll card card--glow p-8">
                <h3 class="text-lg font-bold text-white mb-4"><%= t.compulsion.checklistTitle %></h3>
                <ul class="space-y-3 text-gray-400 list-disc list-inside">
                    <% t.compulsion.checklist.forEach(function (item) { %>
                    <li><%- item %></li>
                    <% }); %>
                </ul>
            </div>
            <div class="animate-on-scroll card card--glow p-8">
                <h3 class="text-lg font-bold text-white mb-4"><%= t.compulsion.hook0Title %></h3>
                <p class="text-gray-400"><%- t.compulsion.hook0Html %></p>
            </div>
        </div>

        <% if (t.compulsion.legalHtml) { %>
        <div class="animate-on-scroll card card--glow p-8 mt-8">
            <h3 class="text-lg font-bold text-white mb-4"><%= t.compulsion.legalTitle %></h3>
            <p class="text-gray-400 text-sm leading-relaxed"><%- t.compulsion.legalHtml %></p>
        </div>
        <% } %>
    </div>
</section>

<!-- The levers Hook0 gives you (verifiable properties, framed as levers, never
     as a certification or a claimed sovereignty level). -->
<section class="section relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="blur-circle blur-circle--indigo w-64 h-64 top-1/3 left-0 opacity-10"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 animate-on-scroll">
            <span class="section__eyebrow"><%= t.levers.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.levers.h2 %></h2>
            <p class="mt-4 text-body text-gray-400 max-w-2xl mx-auto"><%= t.levers.intro %></p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 stagger-children">
            <% t.levers.cards.forEach(function (c) { %>
            <div class="animate-on-scroll card card--glow p-8">
                <h3 class="text-xl font-bold text-white mb-3"><%= c.title %></h3>
                <p class="text-gray-400"><%- c.bodyHtml %></p>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- FAQ Section (feeds FAQPage JSON-LD via faqToSchema; GEO extractable Q&A) -->
<section class="section relative overflow-hidden">
    <div class="absolute inset-0 grid-pattern opacity-20"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 animate-on-scroll">
            <span class="section__eyebrow"><%= t.faq.eyebrow %></span>
            <h2 class="mt-4 text-display font-bold text-white"><%= t.faq.h2 %></h2>
        </div>

        <div class="space-y-6 stagger-children">
            <% t.faq.items.forEach(function (f) { %>
            <div class="animate-on-scroll card card--glow p-6">
                <h3 class="text-lg font-semibold text-white mb-2"><%= f.q %></h3>
                <p class="text-gray-400"><%- f.a %></p>
            </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Related Pages -->
<section class="py-12 relative">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-lg font-semibold text-gray-400 mb-6 text-center"><%= t.related.h2 %></h2>
        <div class="flex flex-wrap justify-center gap-4 text-sm">
            <% t.related.links.forEach(function (l) { %>
            <a href="<%= getPath(l.enSlug, locals.pageLang) || getPath(l.enSlug, 'en') %>" class="text-indigo-400 hover:text-indigo-300 underline"><%= l.label %></a>
            <% }); %>
        </div>
    </div>
</section>

<!-- CTA Section -->
<%- include('./includes/_cta-inline.ejs') %>

<%- include('./includes/_footer.ejs') %>

</body>
</html>
