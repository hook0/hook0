# Hook0 — Netlify security headers
# Applied to every response served from www.hook0.com.
# CSP allowlist tracks the third parties actually referenced from _head.ejs
# (Matomo, Crisp chat, Google Ads gtag, Product Hunt badge).
# fonts.googleapis.com / fonts.gstatic.com stay forbidden — Inter is self-hosted.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # 'unsafe-inline' is needed for the inline <script> blocks shipped by
  # _head.ejs (Crisp loader, Matomo bootstrap, gtag setup, UTM persistence,
  # scroll observer). 'unsafe-eval' is deliberately omitted — none of the
  # shipped scripts use eval/new Function, and Matomo/Crisp/gtag don't
  # require it in our usage. If Google Ads conversion tracking ever needs
  # GTM custom templates, re-add 'unsafe-eval' with a referenced ticket.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://app.hook0.com; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://matomo.hook0.com https://*.crisp.chat https://www.googletagmanager.com https://api.producthunt.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://matomo.hook0.com https://*.crisp.chat wss://*.crisp.chat https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://api.producthunt.com; frame-src 'self' https://*.crisp.chat https://api.producthunt.com; manifest-src 'self'; worker-src 'self'

# Self-hosted Inter font files. Their names carry no content hash — static/ is
# copied verbatim into dist/, outside Parcel's hashing — so the URL stays the
# same when the bytes change. `immutable` would therefore be a promise we
# cannot keep: swapping Inter would never reach anyone who already had it
# cached, and a reload would not dislodge it either. A long freshness window
# plus revalidation costs the same in practice and leaves a way to push a fix.
# scripts/i18n-gate fails the build if any rule here lets a cache go longer than
# this window without checking back, unless hashed filenames back it up.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
  Access-Control-Allow-Origin: *

# Brand assets, under the same constraint as the fonts above: static/ is copied
# verbatim into dist/, so these names never change when the artwork does. They
# have one consumer the fonts do not, though — the transactional emails embed the
# banner from here by absolute URL, and a wrong mark sitting in someone's inbox
# is not a thing a reload fixes. A 30-day window let exactly that happen after
# the 2026 rebrand: the origin served the new banner within the hour and the CDN
# went on handing out the old one for weeks. A day of freshness plus revalidation
# keeps the CDN doing its job for the media kit's bulk downloads while bounding
# how long a brand change can stay invisible.
/mediakit/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
