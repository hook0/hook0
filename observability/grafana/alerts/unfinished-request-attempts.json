      "datasourceUid": "bev6em79t7jlsc",
      "model": {
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "bev6em79t7jlsc" },
        "editorMode": "code",
        "format": "table",
        "instant": false,
        "intervalMs": 60000,
        "maxDataPoints": 43200,
        "range": true,
        "rawQuery": true,
        "rawSql": "select count(ra.request_attempt__id)\r\nfrom webhook.request_attempt as ra\r\ninner join webhook.subscription as s on s.subscription__id = ra.subscription__id\r\ninner join event.application as a on a.application__id = s.application__id\r\nwhere\r\n  ra.failed_at is null and ra.succeeded_at is null\r\n  and (s.is_enabled = false or s.deleted_at is not null or a.deleted_at is not null)",
        "refId": "A",
