  "annotations": {
    "__dashboardUid__": "7234fdd7-36fb-4477-abe3-32f94ad90463",
    "__panelId__": "1",
    "summary": "There are too much unfinished request attempts, which may bloat partial index `webhook.request_attempt_waiting_idx`. They should be marked as failed. NOTE: this rule only counts attempts on DISABLED/DELETED subscriptions; live-subscription backlog is covered by 'Delivery backlog — past-due request attempts'. noData/execErr set to Alerting so a broken query pages instead of going silent."
  },
  "notification_settings": { "receiver": "Better Uptime" },
  "data": [
    {
